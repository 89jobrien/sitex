project: sitex
default: ci
budget: { calls: 20 }

targets:
  format:
    steps:
      - step: format_run
        handler: shell::capture
        args:
          cmd: "crux run scripts/format.crux"

  lint:
    steps:
      # TODO(content-contracts): Validate frontmatter, duplicate H1s, assets, and links.
      - step: lint_run
        handler: shell::capture
        args:
          cmd: "crux run scripts/lint.crux"

  graph:
    steps:
      - step: graph_tests
        handler: shell::capture
        args:
          cmd: "bun run test"
      - step: graph_freshness
        handler: shell::capture
        args:
          cmd: "bun run graph:check"

  check:
    depends: [graph]
    steps:
      - step: zola_check
        handler: shell::capture
        args:
          cmd: "zola check --skip-external-links"

  build:
    depends: [check]
    steps:
      - step: zola_build
        handler: shell::capture
        args:
          cmd: "zola build"

  serve:
    steps:
      - step: zola_serve_open
        handler: shell::exec
        args:
          # long-running dev server; not part of `ci` — run standalone
          cmd: "zola serve --open"

  ci:
    depends: [lint, build]
