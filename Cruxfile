project: sitex
default: ci
budget: { calls: 20 }

targets:
  format:
    steps:
      - step: format_run
        handler: shell::capture
        args: { cmd: "crux run scripts/format.crux" }

  format-check:
    steps:
      - step: format_check_run
        handler: shell::capture
        args: { cmd: "crux run scripts/format-check.crux" }

  lint:
    steps:
      - step: lint_run
        handler: shell::capture
        args: { cmd: "crux run scripts/lint.crux" }

  # Standalone access to the content-graph gates. They also run inside
  # scripts/check.crux, so `check` and `ci` do not need this target.
  graph:
    steps:
      - step: graph_tests
        handler: shell::capture
        args: { cmd: "bun run test" }
      - step: graph_freshness
        handler: shell::capture
        args: { cmd: "bun run graph:check" }

  check:
    steps:
      - step: check_run
        handler: shell::capture
        args: { cmd: "crux run scripts/check.crux" }

  build:
    depends: [check]
    steps:
      - step: build_run
        handler: shell::capture
        args: { cmd: "crux run scripts/build.crux" }

  serve:
    steps:
      - step: serve_run
        handler: shell::capture
        args: { cmd: "crux run scripts/serve.crux" }

  ci:
    steps:
      - step: ci_run
        handler: shell::capture
        args: { cmd: "crux run scripts/ci.crux" }
