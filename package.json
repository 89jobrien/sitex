{
  "name": "sitex",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.22.1"
  },
  "scripts": {
    "format": "prettier --write --no-error-on-unmatched-pattern README.md CLAUDE.md 'content/**/*.md' 'docs/**/*.md' 'ideas/**/*.md' 'sass/**/*.scss' 'scripts/content-graph/**/*.mjs'",
    "format:check": "prettier --check --no-error-on-unmatched-pattern README.md CLAUDE.md 'content/**/*.md' 'docs/**/*.md' 'ideas/**/*.md' 'sass/**/*.scss' 'scripts/content-graph/**/*.mjs'",
    "lint:markdown": "markdownlint-cli2 README.md CLAUDE.md 'content/**/*.md' 'docs/**/*.md' 'ideas/**/*.md'",
    "test": "node --test 'scripts/content-graph/*.test.mjs'",
    "graph:data:write": "node scripts/content-graph/generate.mjs --write",
    "graph:data:check": "node scripts/content-graph/generate.mjs --check",
    "graph:bundle": "node scripts/content-graph/bundle.mjs --write",
    "graph:bundle:check": "node scripts/content-graph/bundle.mjs --check",
    "graph:write": "bun run graph:data:write && bun run graph:bundle",
    "graph:check": "bun run graph:data:check && bun run graph:bundle:check",
    "verify": "bun run format:check && bun run lint:markdown && bun run test && bun run graph:check && zola check && zola build"
  },
  "devDependencies": {
    "d3-force": "3.0.0",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "esbuild": "0.28.2",
    "linkedom": "0.18.13",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "smol-toml": "1.8.0"
  }
}
