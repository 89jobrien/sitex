pipeline: lint
budget: { calls: 4 }

steps:
  - step: prettier_check
    handler: shell::capture
    args:
      cmd: "bun run format:check"

  - step: markdownlint_check
    handler: shell::capture
    args:
      cmd: "bun run lint:markdown"

  - step: log_result
    handler: ctrl::log
    args: { field: stdout, compact: true }
