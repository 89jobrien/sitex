pipeline: format-check
budget: { calls: 4 }

steps:
  - step: prettier_check
    handler: shell::capture
    args:
      # .zk/templates/*.md stays excluded because Prettier corrupts zk template expressions.
      # Keep this file list aligned with the format/format:check scripts in package.json.
      cmd: "npx --no-install prettier --no-error-on-unmatched-pattern --check README.md CLAUDE.md 'content/**/*.md' 'docs/**/*.md' 'ideas/**/*.md' 'sass/**/*.scss' 'scripts/content-graph/**/*.mjs'"

  - step: log_result
    handler: ctrl::log
    args: { field: stdout, compact: true }
